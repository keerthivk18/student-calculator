
pipeline {
    agent any

    options {
        skipDefaultCheckout(true)
        timeout(time: 5, unit: 'MINUTES')
    }

    parameters {
        booleanParam(
            name: 'RUN_APP',
            defaultValue: true,
            description: 'Run application'
        )
    }

    stages {
        stage('Checkout') {
            steps {
                deleteDir()
                checkout scm
            }
        }

        stage('Verify') {
            steps {
                bat 'java -version'
                bat 'mvn -version'
                bat 'dir'
            }
        }
    }
}
